#!/usr/bin/env bash
# ==============================================================================
# Vula HUD Floating Launcher for GNOME Shell
# ==============================================================================

export PATH="$HOME/.local/bin:$HOME/.local/go/bin:$PATH"
export LD_LIBRARY_PATH="$HOME/.local/lib:$LD_LIBRARY_PATH"

if command -v gnome-terminal &> /dev/null; then
    exec gnome-terminal --title="⚡ Vula HUD" --geometry=78x22 -- "$HOME/.local/bin/vula" hud
else
    exec "$HOME/.local/bin/vula" hud
fi
